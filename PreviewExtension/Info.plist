<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>QLSupportedContentTypes</key>
			<array>
				<!-- Broad text families -->
				<string>public.plain-text</string>
				<string>public.source-code</string>
				<string>public.script</string>
				<string>public.shell-script</string>
				<string>public.xml</string>
				<string>public.json</string>
				<string>public.yaml</string>
				<string>public.css</string>
				<!-- Specific types: the system previewer claims these exactly,
				     and Quick Look picks the most specific claim, so broad
				     parent types alone lose the election for them. -->
				<string>public.swift-source</string>
				<string>public.c-source</string>
				<string>public.c-header</string>
				<string>public.c-plus-plus-source</string>
				<string>public.c-plus-plus-header</string>
				<string>public.objective-c-source</string>
				<string>public.objective-c-plus-plus-source</string>
				<string>public.zsh-script</string>
				<string>public.bash-script</string>
				<string>public.csh-script</string>
				<string>public.python-script</string>
				<string>public.ruby-script</string>
				<string>public.perl-script</string>
				<string>public.php-script</string>
				<string>com.sun.java-source</string>
				<string>com.netscape.javascript-source</string>
				<string>net.daringfireball.markdown</string>
				<string>public.toml</string>
				<string>com.microsoft.ini</string>
				<string>org.iso.sql</string>
				<string>public.patch-file</string>
				<string>com.apple.log</string>
				<string>public.log</string>
				<string>public.make-source</string>
				<string>public.dtrace-source</string>
				<string>public.protobuf-source</string>
				<string>public.assembly-source</string>
				<string>public.lex-source</string>
				<!-- Third-party declared types: whichever installed app declares
				     a type (BBEdit, Go, Kotlin) becomes the file's effective UTI. -->
				<string>org.golang.go-source</string>
				<string>org.kotlinlang.kotlin-source</string>
				<string>com.barebones.bbedit.toml-source</string>
				<string>com.barebones.bbedit.typescript-source</string>
				<string>com.barebones.bbedit.rust-source</string>
				<string>com.barebones.bbedit.go-source</string>
				<string>com.barebones.bbedit.ini-configuration</string>
				<string>com.microsoft.typescript</string>
				<string>public.ndjson</string>
				<!-- Catch-all: files nothing else claims (dotfiles like .zprofile,
				     unknown text formats) are typed public.data and otherwise get
				     no preview at all. More specific claims from other providers
				     always win, and binary content is declined at runtime. -->
				<string>public.data</string>
				<!-- Dynamic UTIs: deterministic encodings of extensions that no
				     installed app declares (jsonl, fish, lua, conf, d, ...).
				     Quick Look's provider matching does NOT walk conformance
				     from dyn types to the public.data claim: each extension we
				     want served needs its exact dyn identifier listed. -->
				<string>dyn.ah62d4rv4ge80k</string>
				<string>dyn.ah62d4rv4ge80255dqf0a</string>
				<string>dyn.ah62d4rv4ge81y65kfz4gu3prqy</string>
				<string>dyn.ah62d4rv4ge81k3u</string>
				<string>dyn.ah62d4rv4ge81g7pr</string>
				<string>dyn.ah62d4rv4ge80255drq</string>
				<string>dyn.ah62d4rv4ge80y65tr30a</string>
				<string>dyn.ah62d4rv4ge81a63v</string>
				<string>dyn.ah62d4rv4ge81a65rge</string>
				<string>dyn.ah62d4rv4ge81a65ege</string>
				<string>dyn.ah62d4rv4ge80q4pxra</string>
				<string>dyn.ah62d4rv4ge8027pb</string>
				<string>dyn.ah62d4rv4ge80g55sq2</string>
				<string>dyn.ah62d4rv4ge80s4pyrfx0655wqy</string>
				<string>dyn.ah62d4rv4ge81y65ksmvu</string>
				<string>dyn.ah62d4rv4ge80n5x0</string>
				<string>dyn.ah62d4rv4ge81g7xfrv4gn</string>
				<string>dyn.ah62d4rv4ge80g4xx</string>
				<string>dyn.ah62d4rv4ge81e2ppqy</string>
				<string>dyn.ah62d4rv4ge80s3prsr2gn22</string>
				<string>com.apple.applescript.text</string>
				<string>com.apple.property-list</string>
				<string>com.apple.xml-property-list</string>
				<string>com.apple.ascii-property-list</string>
				<string>com.apple.xcode.configsettings</string>
				<string>com.apple.xcode.strings-text</string>
				<string>com.apple.xcode.entitlements-property-list</string>
			</array>
			<key>QLSupportsSearchableItems</key>
			<false/>
			<key>QLIsDataBasedPreview</key>
			<false/>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).PreviewViewController</string>
	</dict>
</dict>
</plist>
