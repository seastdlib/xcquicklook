				<string>public.protobuf-source</string>
				<string>public.assembly-source</string>
				<string>public.lex-source</string>
				<!-- Third-party declared types: whichever installed app declares
				     a type (BBEdit, Go, Kotlin) becomes the file's effective UTI. -->
				<string>org.golang.go-source</string>
				<string>org.kotlinlang.kotlin-source</string>
				<string>com.barebones.bbedit.toml-source</string>
				<string>com.barebones.bbedit.typescript-source</string>
				<string>com.barebones.bbedit.rust-source</string>
				<string>com.barebones.bbedit.go-source</string>
				<string>com.barebones.bbedit.ini-configuration</string>
				<string>com.microsoft.typescript</string>
				<string>public.ndjson</string>
				<!-- Catch-all: files nothing else claims (dotfiles like .zprofile,
				     unknown text formats) are typed public.data and otherwise get
				     no preview at all. More specific claims from other providers
				     always win, and binary content is declined at runtime. -->
				<string>public.data</string>
				<!-- Dynamic UTIs: deterministic encodings of extensions that no
				     installed app declares (jsonl, fish, lua, conf, ...). -->
				<string>dyn.ah62d4rv4ge80y65tr30a</string>
				<string>dyn.ah62d4rv4ge80q4pxra</string>
				<string>dyn.ah62d4rv4ge8027pb</string>
